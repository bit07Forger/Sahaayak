{
  "name": "sahaayak-backend",
  "version": "1.0.0",
  "description": "Backend API for Sahaayak MVP",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "nodemon --watch src -e ts --exec ts-node src/index.ts",
    "seed:services:dry-run": "node scripts/seed.mjs --dry-run",
    "seed:services:apply": "node scripts/seed.mjs --apply",
    "seed:services:check": "node scripts/seed.mjs --check"
  },
  "dependencies": {
    "@google/genai": "^2.3.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "firebase-admin": "^12.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.24",
    "nodemon": "^3.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
