rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isValidUserResource(uid) {
      let data = request.resource.data;
      return data.uid == uid 
        && data.keys().hasOnly(['uid', 'email', 'preferences', 'createdAt', 'updatedAt'])
        && data.preferences.keys().hasOnly(['textSize', 'contrast', 'voiceSpeed', 'voiceEnabled'])
        && data.preferences.textSize in ['normal', 'large', 'xlarge']
        && data.preferences.contrast in ['normal', 'high']
        && data.preferences.voiceSpeed in ['slow', 'normal', 'fast']
        && data.preferences.voiceEnabled is bool;
    }

    function isValidProgressResource(serviceId) {
      let data = request.resource.data;
      return data.serviceId == serviceId
        && data.keys().hasOnly(['serviceId', 'currentStep', 'status', 'answers', 'documentStatuses', 'updatedAt'])
        && data.currentStep is int
        && data.status in ['NOT_STARTED', 'IN_PROGRESS', 'COMPLETED'];
    }

    // Default Deny Catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // A. Service Content (Read-only by authenticated users, no client writes)
    match /services/{serviceId} {
      allow read: if isAuthenticated();
      allow write: if false;

      match /questions/{questionId} {
        allow read: if isAuthenticated();
        allow write: if false;
      }

      match /documents/{documentId} {
        allow read: if isAuthenticated();
        allow write: if false;
      }
    }

    // B. User Profile Data (Owner-only read/write, strict validation, no delete)
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && isValidUserResource(uid);
      allow delete: if false;

      // C. Workflow Progress (Owner-only read/write, strict validation, no delete)
      match /workflowProgress/{serviceId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && isValidProgressResource(serviceId);
        allow delete: if false;
      }
    }
  }
}
